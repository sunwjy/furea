{
  "name": "furea",
  "version": "0.0.0",
  "description": "Self-hosted URL shortener on Cloudflare Workers, D1 and KV, installed with one command.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunwjy/furea.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "furea": "bin/furea.js"
  },
  "files": [
    "bin",
    "dist",
    "migrations"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@furea/admin": "workspace:*",
    "@furea/shared": "workspace:*",
    "@furea/worker": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
