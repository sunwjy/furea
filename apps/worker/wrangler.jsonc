// Development-only configuration: `wrangler dev`, local migrations and the Workers test pool.
// Never published; the installer reads dist/manifest.json instead (ADR 0007).
// Compatibility settings and binding names must match src/manifest.ts (checked by src/manifest.test.ts).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "furea-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [],
  "assets": {
    "directory": "../admin/dist/assets",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "furea-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "CLICKS",
      "dataset": "furea_clicks"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_IP_LIMITER",
      "namespace_id": "730016001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "LOGIN_GLOBAL_LIMITER",
      "namespace_id": "730016002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "FUREA_VERSION": "0.0.0-dev"
  }
}
